# RecoverX Backend Environment Configuration

# Database (Render PostgreSQL)
DATABASE_URL=postgresql://recoverx:your_secure_password@localhost:5432/recoverx

# Redis (Upstash / Local Redis)
REDIS_URL=redis://localhost:6379/0

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Security & Multi-Tenancy (Phase 6)
JWT_SECRET=your-secure-random-256-bit-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# CORS Configuration (Production Frontend)
CORS_ORIGINS=["https://recover-x-sage.vercel.app","http://localhost:5173"]

# Razorpay Credentials (Optional / Live Gateway)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# AI Agent Configuration (Phase 3)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
LLM_MODEL=gemini-1.5-flash
MAX_RETRY_ATTEMPTS=3
AGENT_CONFIDENCE_THRESHOLD=0.5
