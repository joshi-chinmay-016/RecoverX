# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Database
DATABASE_URL=postgresql://recoverx:your_secure_password@localhost:5432/recoverx

# Redis
REDIS_URL=redis://localhost:6379/0

# Application
APP_ENV=development
LOG_LEVEL=INFO

# LLM Provider (Phase 3)
LLM_PROVIDER=gemini  # Options: gemini, groq, openai, mock
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_API_KEY=  # Generic fallback for any provider key
LLM_MODEL=gemini-1.5-flash  # e.g. gemini-1.5-flash, gemini-2.0-flash, llama3-70b-8192, gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
MAX_AGENT_STEPS=6
AGENT_VERSION=agent-v1
PROMPT_VERSION=recovery-prompt-v1
POLICY_VERSION=policy-v1

# Agent Policy Configuration
MAX_RETRY_ATTEMPTS=3
AGENT_CONFIDENCE_THRESHOLD=0.5

# Security & Multi-Tenancy (Phase 6)
JWT_SECRET=your-secure-random-256-bit-jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=8

# CORS Configuration
CORS_ORIGINS=["https://recover-x-sage.vercel.app","http://localhost:5173"]

# Frontend Configuration
# Development: http://localhost:8000
# Production on Vercel: https://recoverx-v65y.onrender.com
VITE_API_BASE_URL=http://localhost:8000
